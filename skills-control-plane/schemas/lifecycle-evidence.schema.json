{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotalbot.local/hermes/lifecycle-evidence.schema.json",
  "title": "Hash-bound skill lifecycle evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "result", "project", "candidate_bundle_sha256", "candidate_manifest_sha256", "control_commit", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"enum": ["compatibility", "canary", "fresh-session", "rollback-verification"]},
    "result": {"enum": ["PASS", "BLOCK"]},
    "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "candidate_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "control_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "result", "evidence_sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "result": {"enum": ["PASS", "BLOCK"]},
          "evidence_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
