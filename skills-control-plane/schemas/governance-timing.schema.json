{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/hermes/skills-control-plane/governance-timing.schema.json",
  "title": "Governed work-item timing ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_item", "boot_id", "state", "started_at_utc", "started_monotonic_ns", "current", "intervals", "idempotency"],
  "properties": {
    "schema_version": {"const": 1},
    "work_item": {"type": "string", "pattern": "^[A-Z]+-[0-9]+$"},
    "boot_id": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
    "state": {"enum": ["running", "finalized"]},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "started_monotonic_ns": {"type": "integer", "minimum": 0},
    "current": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/openInterval"}]},
    "intervals": {"type": "array", "items": {"$ref": "#/$defs/closedInterval"}},
    "idempotency": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "finalized_at_utc": {"type": "string", "format": "date-time"},
    "finalized_monotonic_ns": {"type": "integer", "minimum": 0},
    "total_wall_ns": {"type": "integer", "minimum": 0},
    "interval_total_ns": {"type": "integer", "minimum": 0},
    "unattributed_gap_ns": {"type": "integer", "minimum": 0},
    "category_totals_ns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_execution", "queue_wait", "reviewer_remediation", "operator_delay"],
      "properties": {
        "active_execution": {"type": "integer", "minimum": 0},
        "queue_wait": {"type": "integer", "minimum": 0},
        "reviewer_remediation": {"type": "integer", "minimum": 0},
        "operator_delay": {"type": "integer", "minimum": 0}
      }
    },
    "stage_totals_ns": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{0,63}$"},
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "category": {"enum": ["active_execution", "queue_wait", "reviewer_remediation", "operator_delay"]},
    "openInterval": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "category", "started_at_utc", "started_monotonic_ns"],
      "properties": {
        "stage": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "category": {"$ref": "#/$defs/category"},
        "started_at_utc": {"type": "string", "format": "date-time"},
        "started_monotonic_ns": {"type": "integer", "minimum": 0}
      }
    },
    "closedInterval": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "category", "started_at_utc", "started_monotonic_ns", "ended_at_utc", "ended_monotonic_ns", "duration_ns", "outcome"],
      "properties": {
        "stage": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "category": {"$ref": "#/$defs/category"},
        "started_at_utc": {"type": "string", "format": "date-time"},
        "started_monotonic_ns": {"type": "integer", "minimum": 0},
        "ended_at_utc": {"type": "string", "format": "date-time"},
        "ended_monotonic_ns": {"type": "integer", "minimum": 0},
        "duration_ns": {"type": "integer", "minimum": 0},
        "outcome": {"enum": ["PASS", "BLOCK", "TIMEOUT", "WAIT", "CONTINUE"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "finalized"}}},
      "then": {"required": ["finalized_at_utc", "finalized_monotonic_ns", "total_wall_ns", "interval_total_ns", "unattributed_gap_ns", "category_totals_ns", "stage_totals_ns"], "properties": {"current": {"type": "null"}}}
    }
  ]
}
