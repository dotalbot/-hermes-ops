{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotalbot.local/hermes/skill-canary-request.schema.json",
  "title": "Governed skill canary rollout request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate", "project", "profile", "skills", "compatibility_evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["layer", "name", "version", "source_path", "manifest_path", "bundle_sha256", "manifest_sha256"],
      "properties": {
        "layer": {"enum": ["release", "pack"]},
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "version": {"$ref": "#/$defs/semver"},
        "source_path": {"$ref": "#/$defs/absolutePath"},
        "manifest_path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+\\.ya?ml$", "not": {"pattern": "(^|/)\\.\\.(/|$)"}},
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "profile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
    "skills": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "source_relative_path"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "source_relative_path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$", "not": {"pattern": "(^|/)\\.\\.(/|$)"}}
        }
      }
    },
    "compatibility_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["project", "path", "sha256"],
      "properties": {
        "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "absolutePath": {"type": "string", "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"}
  }
}
