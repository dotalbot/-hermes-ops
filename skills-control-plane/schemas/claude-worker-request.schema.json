{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotalbot.invalid/schemas/claude-worker-request.schema.json",
  "title": "Governed Claude worker request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "mode",
    "base_commit",
    "specification",
    "task",
    "checks",
    "model",
    "effort",
    "timeout_seconds",
    "output_path"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "attempt_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "mode": {"enum": ["implementation", "review"]},
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "branch": {
      "type": "string",
      "pattern": "^(feat|fix|docs|test|refactor|chore)/[a-z0-9][a-z0-9._-]{1,80}$"
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^[A-Za-z0-9._/-]+$"
      }
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/[A-Za-z0-9._/-]+\\.md$",
          "maxLength": 240
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "task": {"type": "string", "minLength": 1, "maxLength": 8000},
    "checks": {
      "type": "array",
      "items": {"enum": ["format", "analyze", "test"]},
      "uniqueItems": true,
      "maxItems": 3
    },
    "model": {"enum": ["sonnet", "opus"]},
    "effort": {"enum": ["low", "medium", "high", "xhigh", "max"]},
    "timeout_seconds": {"type": "integer", "minimum": 60, "maximum": 3600},
    "output_path": {
      "type": "string",
      "pattern": "^/home/jellybot/projects/jellyssh-claude-adapter/evidence/[a-zA-Z0-9._-]+\\.json$"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "implementation"}}},
      "then": {"required": ["branch", "allowed_paths"], "not": {"required": ["target_commit"]}}
    },
    {
      "if": {"properties": {"mode": {"const": "review"}}},
      "then": {
        "required": ["target_commit"],
        "allOf": [
          {"not": {"required": ["branch"]}},
          {"not": {"required": ["allowed_paths"]}}
        ]
      }
    }
  ]
}
